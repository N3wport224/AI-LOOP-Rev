# Copy to .env (git-ignored, chmod 600) and fill in. Sourced by deploy/run_agent.sh (launchd/systemd).
# --- storefronts (any one is enough; Stripe gives the fully closed loop) ---
STRIPE_SECRET_KEY=
LEMONSQUEEZY_API_KEY=
GUMROAD_ACCESS_TOKEN=
# STRIPE_WEBHOOK_SECRET is written by `automonetize setup-autonomous`,
# PUBLIC_WEBHOOK_URL by deploy/tunnel/setup_tunnel.sh.
STRIPE_WEBHOOK_SECRET=
PUBLIC_WEBHOOK_URL=
# --- GitHub showcase / Pages / view tracking / Discussions ---
GITHUB_TOKEN=
# --- syndication ---
DEVTO_API_KEY=
HASHNODE_TOKEN=
# --- email ---
SMTP_PASSWORD=
IMAP_PASSWORD=
SENDGRID_API_KEY=
POSTMARK_SERVER_TOKEN=
# Flip to false only after `automonetize dispatch --check` reports no problems.
DRY_RUN=true

# Autonomous code evolution: let the agent patch its own heuristics (parsers, tech vocabulary,
# landing-page copy) after the full test suite + simulator pass in a sandboxed git worktree.
# Changes are local commits (never pushed), watched for an hour and auto-reverted on regressions.
# Needs a clean git checkout. Inspect with `automonetize evolution log`.
ENABLE_AUTONOMOUS_CODE_EVOLUTION=false

AUTOMONETIZE_SENDER_NAME=
AUTOMONETIZE_SENDER_EMAIL=
AUTOMONETIZE_SENDER_POSTAL_ADDRESS=

# --- monitoring and notifications ---
# Where reports and alerts go (empty = the sender email).
OWNER_EMAIL=
# healthchecks.io ping URL: you're emailed if the agent stops.
HEALTHCHECK_URL=
# Phone notifications (free ntfy app): `automonetize phone` makes and saves a private topic.
NTFY_TOPIC=
# Sales and alerts in Slack or Discord (Phase 305): `automonetize chat <webhook-url>` checks and saves it.
CHAT_WEBHOOK_URL=

# --- names the control panel uses (aliases of the settings above) ---
# STRIPE_API_KEY= (same as STRIPE_SECRET_KEY)
# SMTP_HOST= SMTP_PORT= SMTP_USER= (or SMTP_USERNAME=)
# CAN_SPAM_POSTAL_ADDRESS= CAN_SPAM_UNSUBSCRIBE_EMAIL=
