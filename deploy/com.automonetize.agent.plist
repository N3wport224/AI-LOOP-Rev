<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd job for AutoMonetize (engine + webhook supervisor). Do not edit the double-underscore
  placeholders by hand: deploy/install_launchd.sh renders this into
  ~/Library/LaunchAgents/ (starts at login) or, with sudo and -system, /Library/LaunchDaemons/
  (starts at boot, runs as your user, no login needed).
  Secrets are NOT stored here: deploy/run_agent.sh loads __WORKDIR__/.env on every start, so no
  terminal or login shell is involved.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.automonetize.agent</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__WORKDIR__/deploy/run_agent.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__WORKDIR__</string>

  <!-- Start at load (login or boot) and restart whenever the process exits for any reason. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Wait at least 30 s between restarts so a crash loop can't spin the CPU. -->
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <!-- SIGTERM on unload/logout; give the supervisor time to finish the cycle and flush SQLite. -->
  <key>ExitTimeOut</key>
  <integer>90</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>__WORKDIR__/.venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>AUTOMONETIZE_ENV_FILE</key>
    <string>__WORKDIR__/.env</string>
  </dict>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/automonetize/agent.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/automonetize/agent.stderr.log</string>

  <!-- Standard (not Background): Background jobs get throttled CPU and I/O on battery. The engine
       sleeps between cycles anyway, and holds a power assertion only while it works. -->
  <key>ProcessType</key>
  <string>Standard</string>
</dict>
</plist>
