# systemd unit: copy to ~/.config/systemd/user/automonetize.service, then
#   systemctl --user daemon-reload && systemctl --user enable --now automonetize
# Logs: journalctl --user -u automonetize -f   (also written to data/agent.log)
[Unit]
Description=AutoMonetize autonomous revenue agent
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/AutoMonetize
EnvironmentFile=-%h/AutoMonetize/.env
ExecStart=%h/AutoMonetize/.venv/bin/automonetize run --headless
Restart=on-failure
RestartSec=60
# SIGTERM lets the current cycle finish its task and exit cleanly.
KillSignal=SIGTERM
TimeoutStopSec=120

[Install]
WantedBy=default.target
